# ── Supabase ──────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только на сервере (edge functions, админ-задачи). Никогда не на клиенте.
SUPABASE_SERVICE_ROLE_KEY=

# ── Web Push (VAPID) ──────────────────────────────────────
# Сгенерировать: node scripts/generate-vapid-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email для контактов Push Services (обязательное поле в VAPID-payload)
VAPID_CONTACT_EMAIL=your@email.com

# ── Cron (Vercel) ─────────────────────────────────────────
# Любая длинная случайная строка. Например: openssl rand -hex 32
# Vercel автоматически добавит её в Authorization при запуске cron.
CRON_SECRET=

# ── PostHog (аналитика) ───────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Sentry (мониторинг ошибок) ────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── Resend (email fallback) ───────────────────────────────
RESEND_API_KEY=
